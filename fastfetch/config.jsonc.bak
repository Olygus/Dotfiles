// Inspired by Catnap
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "~/.config/fastfetch/chi-ro.txt"
    },
    "display": {
        "separator": " ",
        "color": {
            "keys": "#fbf1c7",
            "output": "#fbf1c7"
        }
    },
    "modules": [
        {
            "type": "custom",
            "format": "\u001b[38;2;215;153;33m╔════════╗\u001b[0m"
        },
        {
            "type": "host",
            "key": " ",
            "format": "\u001b[38;2;215;153;33m║\u001b[0m \u001b[38;2;69;133;136m\udb80\udc0d\u001b[0m HOST \u001b[38;2;215;153;33m║\u001b[0m {}"
        },
        {
            "type": "os",
            "key": " ",
            "format": "\u001b[38;2;215;153;33m║\u001b[0m \u001b[38;2;69;133;136m󰌽\u001b[0m OS   \u001b[38;2;215;153;33m║\u001b[0m {} {}"
        },
        {
            "type": "kernel",
            "key": " ",
            "format": "\u001b[38;2;215;153;33m║\u001b[0m \u001b[38;2;69;133;136m󰣇\u001b[0m KERN \u001b[38;2;215;153;33m║\u001b[0m {} {}"
        },
        {
            "type": "cpu",
            "key": " ",
            "format": "\u001b[38;2;215;153;33m║\u001b[0m \u001b[38;2;69;133;136m󰀧\u001b[0m CPU  \u001b[38;2;215;153;33m║\u001b[0m {}  {temperature}",
            "showPeCoreCount": true,
            "temp": true
        },
        {
            "type": "custom",
            "format": "\u001b[38;2;215;153;33m╠════════╣\u001b[0m"
        },
        {
            "type": "uptime",
            "key": " ",
            "format": "\u001b[38;2;215;153;33m║\u001b[0m \u001b[38;2;69;133;136m󰥔\u001b[0m UPT  \u001b[38;2;215;153;33m║\u001b[0m {2}h {3}m"
        },
        {
            "type": "disk",
            "key": " ",
            "format": "\u001b[38;2;215;153;33m║\u001b[0m \u001b[38;2;69;133;136m󰋊\u001b[0m DISK \u001b[38;2;215;153;33m║\u001b[0m {size-used}/{size-total}  {size-percentage}",
            "folders": "/"
        },
        {
            "type": "shell",
            "key": " ",
            "format": "\u001b[38;2;215;153;33m║\u001b[0m \u001b[38;2;69;133;136m\udb80\udd41\u001b[0m SH   \u001b[38;2;215;153;33m║\u001b[0m {}"
        },
        {
            "type": "command",
            "key": " ",
            "text": "bash -lc 'pacman_count=$(command -v pacman >/dev/null && pacman -Qq 2>/dev/null | wc -l || echo 0); flatpak_count=$(command -v flatpak >/dev/null && flatpak list --app --columns=ref 2>/dev/null | wc -l || echo 0); snap_count=$(command -v snap >/dev/null && snap list 2>/dev/null | tail -n +2 | wc -l || echo 0); brew_count=$(command -v brew >/dev/null && brew list --formula 2>/dev/null | wc -l || echo 0); dpkg_count=$(command -v dpkg >/dev/null && dpkg --get-selections 2>/dev/null | grep -c -v \"^$\" || echo 0); npm_count=$(command -v npm >/dev/null && npm -g ls --depth=0 --parseable 2>/dev/null | tail -n +2 | wc -l || echo 0); total=$((pacman_count + flatpak_count + snap_count + brew_count + dpkg_count + npm_count)); printf \"%s (%s pacman)\" \"$total\" \"$pacman_count\"'",
            "format": "\u001b[38;2;215;153;33m║\u001b[0m \u001b[38;2;69;133;136m󰈙\u001b[0m PKGS \u001b[38;2;215;153;33m║\u001b[0m {result}",
        },
        {
            "type": "localip",
            "key": " ",
            "format": "\u001b[38;2;215;153;33m║\u001b[0m \u001b[38;2;69;133;136m󰒢\u001b[0m IP   \u001b[38;2;215;153;33m║\u001b[0m {} ({})"
        },
        {
            "type": "custom",
            "format": "\u001b[38;2;215;153;33m╠════════╣\u001b[0m"
        },
        {
            "type": "colors",
            "symbol": "circle",
            "key": "\u001b[38;2;215;153;33m║\u001b[0m 🎨 COL \u001b[38;2;215;153;33m║\u001b[0m "
        },
        {
            "type": "custom",
            "format": "\u001b[38;2;215;153;33m╚════════╝\u001b[0m"
        }
    ]
}
